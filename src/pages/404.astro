---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for does not exist." path="/404/" noindex={true}>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="font-display text-6xl font-extrabold text-brand-red">404</p>
    <h1 class="font-display mt-4 text-2xl font-extrabold text-[var(--text-strong)]">Page not found</h1>
    <p class="mt-3 text-[var(--text-muted)]">That page does not exist, or it moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/games/" class="rounded-lg bg-[var(--color-red-action)] px-4 py-2 text-sm font-bold text-white hover:bg-[var(--color-red-action-hover)]">Game database</a>
      <a href="/" class="rounded-lg px-4 py-2 text-sm font-bold ring-1 ring-[var(--border)] ring-inset hover:bg-[var(--bg-surface)]">Home</a>
    </div>
  </div>
</BaseLayout>
