---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Prose from '@components/Prose.astro';
import { breadcrumbSchema, graph, organizationSchema, personSchema, websiteSchema } from '@lib/schema';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

const { author } = Astro.props;
const d = author.data;
const path = `/authors/${author.id}/`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about/' },
  { name: d.name, href: path },
];
const { Content } = await render(author);
const jsonLd = graph(organizationSchema(), websiteSchema(), breadcrumbSchema(crumbs), personSchema(author));
---
<BaseLayout title={`${d.name} — ${d.role}`} description={d.bio.slice(0, 160)} path={path} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <header class="mt-6 flex flex-wrap items-start gap-5">
      {d.avatar && <Image src={d.avatar} alt={d.name} width={96} height={96} loading="eager" class="surface size-20 rounded-full object-cover" />}
      <div class="min-w-0 flex-1">
        <h1 class="font-display text-3xl font-extrabold text-white">{d.name}</h1>
        <p class="mt-1 text-sm text-[var(--text-muted)]">{d.role}</p>
        <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{d.bio}</p>
      </div>
    </header>
    {d.testingRig.length > 0 && (
      <section class="surface mt-8 p-5">
        <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Test hardware</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[var(--text-muted)]">{d.testingRig.map((r) => <li>{r}</li>)}</ul>
      </section>
    )}
    <div class="mt-8"><Prose><Content /></Prose></div>
  </div>
</BaseLayout>
