---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import GameCard from '@components/GameCard.astro';
import { SITE } from '@lib/site';
import { graph, organizationSchema, websiteSchema } from '@lib/schema';

const [games, emulators, guides] = await Promise.all([
  getCollection('games', ({ data }) => !data.draft),
  getCollection('emulators', ({ data }) => !data.draft),
  getCollection('guides', ({ data }) => !data.draft),
]);

const when = (e: { data: { updatedAt?: Date; publishedAt?: Date } }) =>
  (e.data.updatedAt ?? e.data.publishedAt)?.getTime() ?? 0;
const latestGames = games.sort((a, b) => when(b) - when(a)).slice(0, 12);
const latestGuides = guides.sort((a, b) => when(b) - when(a)).slice(0, 4);
const jsonLd = graph(organizationSchema(), websiteSchema());
---
<BaseLayout title={SITE.title} description={SITE.description} path="/" jsonLd={jsonLd}>
  <section class="border-b border-[var(--border)] bg-[radial-gradient(60%_80%_at_18%_20%,rgba(248,0,0,0.16),transparent),radial-gradient(60%_80%_at_85%_75%,rgba(46,155,255,0.18),transparent)]">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-24">
      <h1 class="font-display mx-auto max-w-3xl text-4xl leading-[1.1] font-extrabold text-[var(--text-strong)] sm:text-5xl">
        The Nintendo Switch database, <span class="text-brand-red">tested</span>.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">
        Title IDs, firmware requirements, file details and version history for every game — plus
        hands-on emulator compatibility results from real hardware, and a homebrew library you
        can download legally.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/roms/" class="rounded-lg bg-[var(--color-red-action)] px-5 py-2.5 text-sm font-bold text-white hover:bg-[var(--color-red-action-hover)]">Browse the game database</a>
        <a href="/emulators/" class="rounded-lg px-5 py-2.5 text-sm font-bold text-[var(--text)] ring-1 ring-[var(--border)] ring-inset hover:bg-[var(--bg-surface)]">Compare emulators</a>
      </div>
      <dl class="mx-auto mt-12 grid max-w-xl grid-cols-3 gap-6">
        {[
          ['Games', games.length],
          ['Emulators', emulators.length],
          ['Guides', guides.length],
        ].map(([label, n]) => (
          <div>
            <dt class="text-xs tracking-wide text-[var(--text-muted)] uppercase">{label}</dt>
            <dd class="font-display text-2xl font-extrabold text-[var(--text-strong)] tabular-nums">{n}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-14">
    <section>
      <div class="flex items-center justify-between gap-4">
        <h2 class="font-display text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">Recently updated games</h2>
        <a href="/roms/" class="inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-bold text-[var(--text)] ring-1 ring-[var(--border)] ring-inset transition-colors hover:bg-[var(--bg-surface)] hover:text-[var(--text-strong)]">
          All games
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {latestGames.map((g, i) => <GameCard game={g} loading={i < 6 ? 'eager' : 'lazy'} />)}
      </div>
    </section>

    <section class="mt-16">
      <div class="flex items-center justify-between gap-4">
        <h2 class="font-display text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">Latest guides</h2>
        <a href="/guides/" class="inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-bold text-[var(--text)] ring-1 ring-[var(--border)] ring-inset transition-colors hover:bg-[var(--bg-surface)] hover:text-[var(--text-strong)]">
          All guides
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {latestGuides.map((g) => (
          <li class="surface p-5">
            <h3 class="font-display font-bold text-[var(--text-strong)]">
              <a href={`/guides/${g.id}/`} class="hover:text-[var(--accent)]">{g.data.title}</a>
            </h3>
            {g.data.summary && <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{g.data.summary}</p>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
