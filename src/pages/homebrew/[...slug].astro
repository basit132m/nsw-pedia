---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import FaqBlock from '@components/FaqBlock.astro';
import Prose from '@components/Prose.astro';
import { breadcrumbSchema, faqSchema, graph, organizationSchema, websiteSchema } from '@lib/schema';
import { resolveDescription, resolveKeywords, resolveTitle } from '@lib/meta';

export async function getStaticPaths() {
  const items = await getCollection('homebrew', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const path = `/homebrew/${item.id}/`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Homebrew', href: '/homebrew/' },
  { name: d.title, href: path },
];
const { Content } = await render(item);
const jsonLd = graph(
  organizationSchema(),
  websiteSchema(),
  breadcrumbSchema(crumbs),
  faqSchema(d.faq.filter((f): f is { question: string; answer: string } => Boolean(f.question && f.answer))),
);

const pageTitle = resolveTitle(d.seo.metaTitle, `${d.title} — Free Switch Homebrew Download`);
const pageDescription = resolveDescription(
  d.seo.metaDescription,
  d.summary ?? `${d.title}: free, openly licensed Nintendo Switch homebrew.`,
);
const pageKeywords = resolveKeywords(d.seo.keywords, [
  d.title, 'Switch homebrew', ...d.genres, d.license, 'free download',
]);
---
<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords}
  exactTitle={Boolean(d.seo.metaTitle)} noindex={d.seo.noindex} path={path} type="article" publishedAt={d.publishedAt} updatedAt={d.updatedAt} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <article class="mt-6">
      <header class="flex flex-wrap items-start gap-5">
        {d.cover && <Image src={d.cover} alt={`${d.title} icon`} width={96} height={96} loading="eager" class="surface size-20 object-cover" />}
        <div class="min-w-0 flex-1">
          <h1 class="font-display text-3xl font-extrabold text-white">{d.title}</h1>
          {d.summary && <p class="mt-2 leading-relaxed text-[var(--text-muted)]">{d.summary}</p>}
        </div>
      </header>

      <section aria-labelledby="details" class="surface mt-8 overflow-hidden">
        <h2 id="details" class="font-display border-b border-[var(--border)] px-5 py-3 text-base font-bold tracking-wide text-white uppercase">Details</h2>
        <dl class="divide-y divide-[var(--border)] text-sm">
          {[
            d.author_name && ['Author', d.author_name],
            d.license && ['Licence', d.license],
            d.version && ['Version', d.version],
            d.fileType && ['File type', d.fileType],
            d.fileSize && ['Size', d.fileSize],
            d.requiredFirmware && ['Required firmware', `${d.requiredFirmware} or later`],
            d.genres.length > 0 && ['Category', d.genres.join(', ')],
          ].filter(Boolean).map((row) => {
            const [k, v] = row as [string, string];
            return (
              <div class="grid gap-1 px-5 py-3 sm:grid-cols-[minmax(0,10rem)_1fr] sm:gap-4">
                <dt class="font-medium text-[var(--text-muted)]">{k}</dt>
                <dd>{v}</dd>
              </div>
            );
          })}
        </dl>
      </section>

      {(d.downloadUrl || d.sourceUrl) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {d.downloadUrl && (
            <a href={d.downloadUrl} rel="nofollow noopener" class="rounded-lg bg-[var(--color-blue-brand)] px-4 py-2 text-sm font-bold text-[#04121f] hover:bg-[var(--color-blue-glow)]">
              Download from official releases
            </a>
          )}
          {d.sourceUrl && (
            <a href={d.sourceUrl} rel="nofollow noopener" class="rounded-lg px-4 py-2 text-sm font-bold text-[var(--text)] ring-1 ring-[var(--border)] ring-inset hover:bg-[var(--bg-surface)]">
              View source
            </a>
          )}
        </div>
      )}
      <p class="mt-3 text-xs text-[var(--text-muted)]">
        Links point to the project's own release page. NSWPEDIA does not mirror files and hosts
        nothing that is not licensed for redistribution.
      </p>

      <div class="mt-10 space-y-10">
        <Prose><Content /></Prose>
        <FaqBlock items={d.faq} />
      </div>
    </article>
  </div>
</BaseLayout>
