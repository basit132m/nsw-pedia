---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { breadcrumbSchema, graph, organizationSchema, websiteSchema } from '@lib/schema';

const items = (await getCollection('homebrew', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Homebrew', href: '/homebrew/' }];
const jsonLd = graph(organizationSchema(), websiteSchema(), breadcrumbSchema(crumbs));
---
<BaseLayout
  title="Free Nintendo Switch Homebrew Downloads — Open Source & Public Domain"
  description="A curated library of Nintendo Switch homebrew: open-source games, emulators and utilities released under licences that permit redistribution. Every entry links to the project's own release page."
  path="/homebrew/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="font-display mt-6 text-3xl font-extrabold text-[var(--text-strong)] sm:text-4xl">Homebrew library</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text-muted)]">
      Everything here is licensed for redistribution or in the public domain. We link to each
      project's own release page rather than mirroring files, and we list the licence on every entry.
    </p>
    <p class="mt-4 rounded-lg border border-[var(--border)] bg-[var(--bg-surface)] p-4 text-sm text-[var(--text-muted)]">
      NSWPEDIA does not host, mirror or link to commercial ROM files, system firmware or
      encryption keys.
    </p>
    <ul class="mt-8 space-y-4">
      {items.map((h) => (
        <li class="surface flex flex-wrap items-start gap-4 p-5">
          {h.data.cover && <Image src={h.data.cover} alt={`${h.data.title} icon`} width={64} height={64} class="size-14 rounded-lg object-cover" />}
          <div class="min-w-0 flex-1">
            <h2 class="font-display text-lg font-bold text-[var(--text-strong)]">
              <a href={`/homebrew/${h.id}/`} class="hover:text-[var(--accent)]">{h.data.title}</a>
            </h2>
            {h.data.summary && <p class="mt-1 text-sm leading-relaxed text-[var(--text-muted)]">{h.data.summary}</p>}
            <p class="mt-2 font-mono text-xs text-[var(--text-muted)]">
              {[h.data.fileType, h.data.fileSize, h.data.version && `v${h.data.version}`, h.data.license].filter(Boolean).join(' · ')}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
