---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import GameInfoTable from '@components/GameInfoTable.astro';
import CompatMatrix from '@components/CompatMatrix.astro';
import VersionHistory from '@components/VersionHistory.astro';
import FaqBlock from '@components/FaqBlock.astro';
import RelatedGames from '@components/RelatedGames.astro';
import ScreenshotRow from '@components/ScreenshotRow.astro';
import Prose from '@components/Prose.astro';
import { abs } from '@lib/site';
import { checkQuality } from '@lib/quality';
import { relatedGames } from '@lib/related';
import { resolveDescription, resolveKeywords, resolveTitle } from '@lib/meta';
import { breadcrumbSchema, faqSchema, graph, organizationSchema, personSchema, videoGameSchema, websiteSchema } from '@lib/schema';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => !data.draft);
  return games.map((game) => ({ params: { slug: game.id }, props: { game, all: games } }));
}

const { game, all } = Astro.props;
const d = game.data;

// Warns in the build log; never blocks publishing.
checkQuality(game.id, game.body, d.draft);

const publisher = d.publisher ? await getEntry(d.publisher) : undefined;
const author = d.author ? await getEntry(d.author) : undefined;

const compatRows = await Promise.all(
  d.emulatorCompat.map(async (row) => {
    const emu = row.emulator ? await getEntry(row.emulator) : undefined;
    const tester = row.testedBy ? await getEntry(row.testedBy) : undefined;
    return {
      emulatorName: emu?.data.title ?? row.emulator?.id,
      emulatorSlug: row.emulator?.id,
      platform: row.platform,
      device: row.device,
      fps: row.fps,
      status: row.status,
      notes: row.notes,
      source: row.source,
      sourceUrl: row.sourceUrl,
      testedOn: row.testedOn,
      testedByName: tester?.data.name,
    };
  }),
);

const related = relatedGames(game, all);
const path = `/roms/${game.id}/`;
const url = abs(path);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'ROMs', href: '/roms/' },
  { name: d.title, href: path },
];

const { Content } = await render(game);

// --- metadata -------------------------------------------------------------
// Anything typed into the SEO panel wins. Otherwise it is derived from the
// fields that happen to be filled in.
const titleBits = [
  d.titleId && 'Title ID',
  d.requiredFirmware && 'Firmware',
  compatRows.length > 0 && 'Emulator Compatibility',
].filter(Boolean);
const derivedTitle = titleBits.length ? `${d.title} — ${titleBits.join(', ')}` : d.title;

const specBits = [
  d.fileType && d.fileSize ? `${d.fileType} ${d.fileSize}` : d.fileType || d.fileSize,
  d.titleId && `Title ID ${d.titleId}`,
  d.requiredFirmware && `firmware ${d.requiredFirmware}+`,
].filter(Boolean);
const derivedDescription =
  d.summary ??
  (specBits.length
    ? `${d.title} for Nintendo Switch: ${specBits.join(', ')}.`
    : `${d.title} for Nintendo Switch — details, versions and emulator compatibility.`);

const pageTitle = resolveTitle(d.seo.metaTitle, derivedTitle);
const pageDescription = resolveDescription(d.seo.metaDescription, derivedDescription);
const pageKeywords = resolveKeywords(d.seo.keywords, [
  d.title,
  ...d.alternateTitles,
  ...d.genres,
  publisher?.data.title,
  d.developer,
  d.series,
  'Nintendo Switch',
  d.fileType,
  d.titleId && 'Title ID',
]);

const jsonLd = graph(
  organizationSchema(),
  websiteSchema(),
  author ? personSchema(author) : undefined,
  breadcrumbSchema(crumbs),
  videoGameSchema(game, {
    url,
    publisherName: publisher?.data.title,
    author,
    coverUrl: d.cover ? abs(d.cover.src) : undefined,
  }),
  faqSchema(d.faq.filter((f): f is { question: string; answer: string } => Boolean(f.question && f.answer))),
);

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
const shownDate = d.updatedAt ?? d.publishedAt;
// Cap the banner at the column width or the file's own width, whichever is
// smaller, and only offer srcset widths the source can actually supply.
const COLUMN_WIDTH = 1120;
const BANNER_MAX = d.banner ? Math.min(d.banner.width, COLUMN_WIDTH) : COLUMN_WIDTH;
const BANNER_WIDTHS = [480, 768, 1120].filter((w) => w <= BANNER_MAX).concat(BANNER_MAX);

const badges = [d.region, d.fileType && d.fileSize && `${d.fileType} · ${d.fileSize}`, d.version && `v${d.version}`, d.requiredFirmware && `FW ${d.requiredFirmware}+`].filter(Boolean) as string[];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  exactTitle={Boolean(d.seo.metaTitle)}
  path={path}
  image={d.banner?.src ?? d.cover?.src}
  type="article"
  publishedAt={d.publishedAt}
  updatedAt={d.updatedAt}
  jsonLd={jsonLd}
  noindex={d.seo.noindex}
>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />

    <article class="mt-6">
      {d.banner && (
        /*
         * Never rendered wider than the file actually is — upscaling only
         * softens it. A small banner sits centred at its native size; a large
         * one fills the column. Height is capped so it stays a band rather
         * than dominating the page.
         */
        <div class="mb-8 flex justify-center">
          <Image
            src={d.banner}
            alt={`${d.title} banner`}
            widths={BANNER_WIDTHS}
            sizes={`(max-width: ${BANNER_MAX}px) 100vw, ${BANNER_MAX}px`}
            loading="eager"
            class="surface max-h-[400px] w-full object-cover"
            style={`max-width:${BANNER_MAX}px`}
          />
        </div>
      )}

      <header class={d.cover ? 'grid gap-6 sm:grid-cols-[200px_1fr]' : ''}>
        {d.cover && (
          <div class="w-full max-w-[200px]">
            <Image
              src={d.cover}
              alt={`${d.title} cover art`}
              width={400}
              height={600}
              loading="eager"
              class="surface aspect-[2/3] w-full object-cover"
            />
          </div>
        )}
        <div>
          <h1 class="font-display text-3xl leading-tight font-extrabold text-[var(--text-strong)] sm:text-4xl">{d.title}</h1>
          {d.alternateTitles.length > 0 && (
            <p class="mt-1 text-sm text-[var(--text-muted)]">{d.alternateTitles.join(' · ')}</p>
          )}
          {d.summary && <p class="mt-3 max-w-prose leading-relaxed text-[var(--text-muted)]">{d.summary}</p>}

          {badges.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
              {badges.map((b) => (
                <li class="rounded-full bg-[var(--bg-raised)] px-3 py-1 text-[var(--badge-fg)] ring-1 ring-[var(--border)] ring-inset">{b}</li>
              ))}
            </ul>
          )}

          {d.eshopUrl && (
            <p class="mt-4">
              <a href={d.eshopUrl} rel="nofollow noopener" class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-red-action)] px-4 py-2 text-sm font-bold text-white hover:bg-[var(--color-red-action-hover)]">
                Buy on Nintendo eShop
              </a>
            </p>
          )}
          {(shownDate || author) && (
            <p class="mt-3 text-xs text-[var(--text-muted)]">
              {shownDate && <>Updated <time datetime={shownDate.toISOString()}>{dateFmt.format(shownDate)}</time></>}
              {shownDate && author && ' · '}
              {author && <>by <a href={`/authors/${author.id}/`} class="link-accent">{author.data.name}</a></>}
            </p>
          )}
        </div>
      </header>

      <div class="mt-10 space-y-10">
        <GameInfoTable game={d} publisherSlug={publisher?.id} publisherName={publisher?.data.title} />
        <CompatMatrix rows={compatRows} gameTitle={d.title} />

        {d.deviceTiers.length > 0 && (
          <section aria-labelledby="tiers" class="surface overflow-hidden">
            <h2 id="tiers" class="font-display border-b border-[var(--border)] px-5 py-3 text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">
              What hardware you need
            </h2>
            <ul class="divide-y divide-[var(--border)] text-sm">
              {d.deviceTiers.map((t) => (
                <li class="grid gap-1 px-5 py-3 sm:grid-cols-[minmax(0,9rem)_minmax(0,16rem)_1fr] sm:gap-4">
                  <span class="font-semibold text-[var(--text-strong)]">{t.tier}</span>
                  <span class="text-[var(--text-muted)]">{t.device}</span>
                  <span>{t.result}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {d.knownIssues.length > 0 && (
          <section aria-labelledby="issues" class="surface overflow-hidden">
            <h2 id="issues" class="font-display border-b border-[var(--border)] px-5 py-3 text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">
              Known issues
            </h2>
            <ul class="list-disc space-y-2 px-5 py-4 pl-9 text-sm text-[var(--text-muted)]">
              {d.knownIssues.map((i) => <li>{i}</li>)}
            </ul>
          </section>
        )}

        <VersionHistory rows={d.versionHistory} gameTitle={d.title} />

        <ScreenshotRow images={d.screenshots} title={d.title} />

        <Prose><Content /></Prose>

        <FaqBlock items={d.faq} heading={`${d.title} — frequently asked questions`} />
        <RelatedGames games={related} />
      </div>
    </article>
  </div>
</BaseLayout>
