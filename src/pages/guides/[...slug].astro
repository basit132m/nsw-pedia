---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import FaqBlock from '@components/FaqBlock.astro';
import Prose from '@components/Prose.astro';
import { abs } from '@lib/site';
import { checkQuality } from '@lib/quality';
import { resolveDescription, resolveKeywords, resolveTitle } from '@lib/meta';
import { articleSchema, breadcrumbSchema, faqSchema, graph, organizationSchema, personSchema, websiteSchema } from '@lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const d = guide.data;
checkQuality(guide.id, guide.body, d.draft);

const author = d.author ? await getEntry(d.author) : undefined;

const path = `/guides/${guide.id}/`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: d.title, href: path },
];
const { Content } = await render(guide);
const jsonLd = graph(
  organizationSchema(),
  websiteSchema(),
  author ? personSchema(author) : undefined,
  breadcrumbSchema(crumbs),
  articleSchema(guide, { url: abs(path), author }),
  faqSchema(d.faq.filter((f): f is { question: string; answer: string } => Boolean(f.question && f.answer))),
);
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
const shownDate = d.updatedAt ?? d.publishedAt;

const pageTitle = resolveTitle(d.seo.metaTitle, d.title);
const pageDescription = resolveDescription(d.seo.metaDescription, d.summary ?? d.title);
const pageKeywords = resolveKeywords(d.seo.keywords, [...d.tags, 'Nintendo Switch', d.difficulty]);
---
<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords}
  exactTitle={Boolean(d.seo.metaTitle)} noindex={d.seo.noindex} path={path} type="article" publishedAt={d.publishedAt} updatedAt={d.updatedAt} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <article class="mt-6">
      <h1 class="font-display text-3xl leading-tight font-extrabold text-white sm:text-4xl">{d.title}</h1>
      {d.summary && <p class="mt-3 text-lg leading-relaxed text-[var(--text-muted)]">{d.summary}</p>}
      <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-[var(--text-muted)]">
        {d.difficulty && <span>{d.difficulty}</span>}
        {d.timeRequired && <span>· {d.timeRequired}</span>}
        {shownDate && <span>· Updated <time datetime={shownDate.toISOString()}>{dateFmt.format(shownDate)}</time></span>}
        {author && <span>· by <a href={`/authors/${author.id}/`} class="link-accent">{author.data.name}</a></span>}
      </p>
      <hr class="my-8 border-[var(--border)]" />
      <Prose><Content /></Prose>
      <div class="mt-10"><FaqBlock items={d.faq} /></div>
    </article>
  </div>
</BaseLayout>
