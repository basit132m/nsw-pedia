---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import GameCard from '@components/GameCard.astro';
import { breadcrumbSchema, graph, organizationSchema, websiteSchema } from '@lib/schema';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Games', href: '/games/' }];
const jsonLd = graph(organizationSchema(), websiteSchema(), breadcrumbSchema(crumbs));
---
<BaseLayout
  title="Nintendo Switch Game Database — Title IDs, Firmware & File Details"
  description="Browse every Nintendo Switch game in the NSWPEDIA database. Title ID, Build ID, required firmware, file type and size, version history and tested emulator compatibility for each title."
  path="/games/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="font-display mt-6 text-3xl font-extrabold text-white sm:text-4xl">Nintendo Switch game database</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text-muted)]">
      Every entry carries the full technical block — Title ID, Build ID, required firmware, file
      type and size — alongside emulator compatibility we tested ourselves on named hardware.
    </p>
    <p class="mt-4 text-sm text-[var(--text-muted)]">{games.length} games</p>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {games.map((g, i) => <GameCard game={g} loading={i < 12 ? 'eager' : 'lazy'} />)}
    </div>
  </div>
</BaseLayout>
