---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import FaqBlock from '@components/FaqBlock.astro';
import Prose from '@components/Prose.astro';
import { abs } from '@lib/site';
import { checkQuality } from '@lib/quality';
import { resolveDescription, resolveKeywords, resolveTitle } from '@lib/meta';
import { breadcrumbSchema, faqSchema, graph, organizationSchema, personSchema, softwareApplicationSchema, websiteSchema } from '@lib/schema';

export async function getStaticPaths() {
  const emulators = await getCollection('emulators', ({ data }) => !data.draft);
  return emulators.map((emu) => ({ params: { slug: emu.id }, props: { emu } }));
}

const { emu } = Astro.props;
const d = emu.data;
checkQuality(emu.id, emu.body, d.draft);

const author = d.author ? await getEntry(d.author) : undefined;

const path = `/emulators/${emu.id}/`;
const url = abs(path);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Emulators', href: '/emulators/' },
  { name: d.title, href: path },
];
const { Content } = await render(emu);

const STATUS_STYLE: Record<string, string> = {
  Active: 'bg-emerald-500/15 text-emerald-300 ring-emerald-500/30',
  'Maintenance only': 'bg-amber-500/15 text-amber-300 ring-amber-500/30',
  Fork: 'bg-sky-500/15 text-sky-300 ring-sky-500/30',
  Discontinued: 'bg-red-500/15 text-red-300 ring-red-500/30',
};

const jsonLd = graph(
  organizationSchema(),
  websiteSchema(),
  author ? personSchema(author) : undefined,
  breadcrumbSchema(crumbs),
  softwareApplicationSchema(emu, { url, logoUrl: d.logo ? abs(d.logo.src) : undefined }),
  faqSchema(d.faq.filter((f): f is { question: string; answer: string } => Boolean(f.question && f.answer))),
);
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
const shownDate = d.updatedAt ?? d.publishedAt;

const pageTitle = resolveTitle(d.seo.metaTitle, `${d.title} — Nintendo Switch Emulator Review & Setup`);
const pageDescription = resolveDescription(
  d.seo.metaDescription,
  d.summary ?? `${d.title}: platform support, requirements and setup for Nintendo Switch emulation.`,
);
const pageKeywords = resolveKeywords(d.seo.keywords, [
  d.title, 'Nintendo Switch emulator', ...d.platforms, d.status, 'Switch emulation',
]);
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  exactTitle={Boolean(d.seo.metaTitle)}
  noindex={d.seo.noindex}
  path={path}
  type="article"
  publishedAt={d.publishedAt}
  updatedAt={d.updatedAt}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <article class="mt-6">
      <header class="flex flex-wrap items-start gap-5">
        {d.logo && <Image src={d.logo} alt={`${d.title} logo`} width={96} height={96} loading="eager" class="surface size-20 object-cover" />}
        <div class="min-w-0 flex-1">
          <h1 class="font-display text-3xl font-extrabold text-white sm:text-4xl">{d.title}</h1>
          {d.summary && <p class="mt-2 max-w-prose leading-relaxed text-[var(--text-muted)]">{d.summary}</p>}
          <ul class="mt-3 flex flex-wrap items-center gap-2 text-xs font-semibold">
            {d.status && <li class={`rounded-full px-3 py-1 ring-1 ring-inset ${STATUS_STYLE[d.status] ?? ''}`}>{d.status}</li>}
            {d.latestVersion && <li class="rounded-full bg-[var(--bg-raised)] px-3 py-1 text-[var(--color-chrome-300)] ring-1 ring-[var(--border)] ring-inset">v{d.latestVersion}</li>}
            {d.license && <li class="rounded-full bg-[var(--bg-raised)] px-3 py-1 text-[var(--color-chrome-300)] ring-1 ring-[var(--border)] ring-inset">{d.license}</li>}
          </ul>
        </div>
      </header>

      <section aria-labelledby="specs" class="surface mt-8 overflow-hidden">
        <h2 id="specs" class="font-display border-b border-[var(--border)] px-5 py-3 text-base font-bold tracking-wide text-white uppercase">At a glance</h2>
        <dl class="divide-y divide-[var(--border)] text-sm">
          {[
            d.platforms.length > 0 && ['Platforms', d.platforms.join(', ')],
            d.status && ['Status', d.status],
            d.latestVersion && ['Latest version', d.latestVersion],
            d.license && ['Licence', d.license],
            d.requirements.cpu && ['CPU', d.requirements.cpu],
            d.requirements.gpu && ['GPU', d.requirements.gpu],
            d.requirements.ram && ['RAM', d.requirements.ram],
          ].filter(Boolean).map((row) => {
            const [k, v] = row as [string, string];
            return (
              <div class="grid gap-1 px-5 py-3 sm:grid-cols-[minmax(0,10rem)_1fr] sm:gap-4">
                <dt class="font-medium text-[var(--text-muted)]">{k}</dt>
                <dd>{v}</dd>
              </div>
            );
          })}
        </dl>
      </section>

      {(d.pros.length > 0 || d.cons.length > 0) && (
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {d.pros.length > 0 && (
            <section class="surface p-5">
              <h2 class="font-display text-sm font-bold tracking-wide text-emerald-300 uppercase">Strengths</h2>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[var(--text-muted)]">{d.pros.map((p) => <li>{p}</li>)}</ul>
            </section>
          )}
          {d.cons.length > 0 && (
            <section class="surface p-5">
              <h2 class="font-display text-sm font-bold tracking-wide text-red-300 uppercase">Limitations</h2>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-[var(--text-muted)]">{d.cons.map((c) => <li>{c}</li>)}</ul>
            </section>
          )}
        </div>
      )}

      <div class="mt-10 space-y-10">
        <Prose><Content /></Prose>
        <FaqBlock items={d.faq} />
      </div>

      {(shownDate || author) && (
        <p class="mt-8 text-xs text-[var(--text-muted)]">
          {shownDate && <>Updated <time datetime={shownDate.toISOString()}>{dateFmt.format(shownDate)}</time></>}
          {shownDate && author && ' · '}
          {author && <>by <a href={`/authors/${author.id}/`} class="link-accent">{author.data.name}</a></>}
        </p>
      )}
    </article>
  </div>
</BaseLayout>
