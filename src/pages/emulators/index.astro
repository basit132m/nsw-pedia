---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { breadcrumbSchema, graph, organizationSchema, websiteSchema } from '@lib/schema';

const emulators = (await getCollection('emulators', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Emulators', href: '/emulators/' }];
const jsonLd = graph(organizationSchema(), websiteSchema(), breadcrumbSchema(crumbs), {
  '@type': 'ItemList',
  itemListElement: emulators.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/emulators/${e.id}/`, Astro.site).href,
    name: e.data.title,
  })),
});
---
<BaseLayout
  title="Nintendo Switch Emulators Compared — Platforms, Status & Requirements"
  description="Every Nintendo Switch emulator we track: which platforms each runs on, hardware requirements, licence, maintenance status and what it is actually good at."
  path="/emulators/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-4xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="font-display mt-6 text-3xl font-extrabold text-white sm:text-4xl">Nintendo Switch emulators</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-[var(--text-muted)]">
      Compatibility claims live on individual game pages, tied to a device and a test date.
      These profiles cover what each emulator is, where it runs and what it needs.
    </p>
    <ul class="mt-8 space-y-4">
      {emulators.map((e) => (
        <li class="surface flex flex-wrap items-start gap-4 p-5">
          <Image src={e.data.logo} alt={`${e.data.title} logo`} width={64} height={64} class="size-14 rounded-lg object-cover" />
          <div class="min-w-0 flex-1">
            <h2 class="font-display text-lg font-bold text-white">
              <a href={`/emulators/${e.id}/`} class="hover:text-[var(--color-blue-glow)]">{e.data.title}</a>
            </h2>
            <p class="mt-1 text-sm leading-relaxed text-[var(--text-muted)]">{e.data.summary}</p>
            <p class="mt-2 text-xs text-[var(--color-chrome-500)]">{e.data.status} · {e.data.platforms.join(', ')}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
