---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Prose from '@components/Prose.astro';
import { breadcrumbSchema, graph, organizationSchema, websiteSchema } from '@lib/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'About NSWPEDIA', href: '/about/' }];
const jsonLd = graph(organizationSchema(), websiteSchema(), breadcrumbSchema(crumbs));
---
<BaseLayout title="About NSWPEDIA" description="What NSWPEDIA is, who writes it, how it is funded and what it will and will not publish." path="/about/" jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="font-display mt-6 text-3xl font-extrabold text-[var(--text-strong)] sm:text-4xl">About NSWPEDIA</h1>
    <div class="mt-8">
      <Prose>
        <p>NSWPEDIA is a reference site for the Nintendo Switch. It maintains a structured database of every ROM we cover — Title IDs, Build IDs, firmware requirements, file types and sizes, language support and full version history — alongside emulator compatibility results we produce ourselves on named hardware.</p>
        <h2>What we publish</h2>
        <ul>
          <li>ROM database entries with the complete technical block.</li>
          <li>Emulator profiles covering platforms, requirements, licence and maintenance status.</li>
          <li>Hands-on compatibility testing, recorded per emulator, per platform and per device.</li>
          <li>Setup guides, file format references and hardware recommendations.</li>
          <li>A homebrew library limited to software licensed for redistribution.</li>
        </ul>
        <h2>What we do not publish</h2>
        <p>We do not host, mirror or link to commercial ROM files, Nintendo system firmware or encryption keys. The downloads section carries homebrew and public-domain software only, and every entry states its licence and links to the upstream project rather than a mirror.</p>
        <h2>How we work</h2>
        <p>Every compatibility result on this site carries the device it was produced on and the date it was run, because Switch emulator forks diverge quickly and an undated result is close to useless. Our <a href="/methodology/">testing methodology</a> sets out the hardware, the builds and the procedure.</p>
        <p>Pages are written by named contributors with <a href="/authors/nswpedia-team/">public profiles</a> listing the hardware they test on. Where a page carries data we have not verified first-hand, it says so.</p>
      </Prose>
    </div>
  </div>
</BaseLayout>
