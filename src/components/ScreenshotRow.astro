---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt?: string }[];
  title: string;
}
const { images, title } = Astro.props;

/**
 * Full-size versions for the lightbox, never wider than the source file —
 * upscaling only softens an image.
 */
const full = await Promise.all(
  images.map((im) =>
    getImage({ src: im.src, width: Math.min(im.src.width, 1920), format: 'webp' }),
  ),
);

const payload = images.map((im, i) => ({
  src: full[i]!.src,
  alt: im.alt ?? `${title} screenshot ${i + 1}`,
  w: Math.min(im.src.width, 1920),
  h: Math.round(Math.min(im.src.width, 1920) * (im.src.height / im.src.width)),
}));
---
{images.length > 0 && (
  <section aria-labelledby="shots" data-lightbox>
    <h2 id="shots" class="font-display text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">
      Screenshots
    </h2>

    {/* One row at every width. Narrow screens swipe horizontally rather than
        squeezing four thumbnails down to thumbnail-of-a-thumbnail size. */}
    <ul class="shot-row mt-4 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 sm:grid sm:overflow-visible sm:pb-0"
        style={`--shot-count:${images.length}`}>
      {images.map((im, i) => (
        <li class="w-[72%] shrink-0 snap-start sm:w-auto">
          <button
            type="button"
            class="group surface block w-full cursor-zoom-in overflow-hidden p-0 transition-colors hover:border-[var(--accent)]"
            data-shot={i}
            aria-label={`Open screenshot ${i + 1} of ${images.length} full size`}
          >
            <Image
              src={im.src}
              alt={im.alt ?? `${title} screenshot ${i + 1}`}
              widths={[320, 480, 640]}
              sizes="(max-width: 639px) 72vw, 280px"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="aspect-video w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
            />
          </button>
        </li>
      ))}
    </ul>

    <dialog class="lightbox" aria-label={`${title} screenshots`}>
      <figure class="lightbox__figure">
        <img class="lightbox__img" alt="" width="1600" height="900" />
        <figcaption class="lightbox__caption"></figcaption>
      </figure>
      <button type="button" class="lightbox__btn lightbox__close" aria-label="Close viewer">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <button type="button" class="lightbox__btn lightbox__prev" aria-label="Previous screenshot">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="lightbox__btn lightbox__next" aria-label="Next screenshot">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </dialog>

    <script type="application/json" data-shots set:html={JSON.stringify(payload)} />
  </section>
)}

<style>
  /* Equal columns for however many screenshots the page has. */
  @media (min-width: 640px) {
    .shot-row {
      grid-template-columns: repeat(var(--shot-count), minmax(0, 1fr));
    }
  }

  .lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgb(3 5 8 / 0.9);
    backdrop-filter: blur(2px);
  }
  .lightbox__figure {
    margin: 0;
    display: grid;
    place-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem 3.5rem;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }
  .lightbox__caption {
    color: #cbd5e1;
    font-size: 0.875rem;
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.2);
    cursor: pointer;
  }
  .lightbox__btn:hover { background: rgb(255 255 255 / 0.2); }
  .lightbox__close { top: 1rem; right: 1rem; }
  .lightbox__prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__btn[hidden] { display: none; }

  @media (max-width: 480px) {
    .lightbox__figure { padding: 3.5rem 0.75rem 1.5rem; }
    .lightbox__prev { left: 0.25rem; }
    .lightbox__next { right: 0.25rem; }
  }
</style>

<script>
  // One gallery per page, but written to handle several.
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog.lightbox');
    const dataEl = root.querySelector<HTMLScriptElement>('script[data-shots]');
    if (!dialog || !dataEl) return;

    type Shot = { src: string; alt: string; w: number; h: number };
    const shots: Shot[] = JSON.parse(dataEl.textContent || '[]');
    if (!shots.length) return;

    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lightbox__prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lightbox__next')!;
    const close = dialog.querySelector<HTMLButtonElement>('.lightbox__close')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      const s = shots[index]!;
      img.src = s.src;
      img.alt = s.alt;
      img.width = s.w;
      img.height = s.h;
      caption.textContent =
        shots.length > 1 ? `${s.alt} — ${index + 1} of ${shots.length}` : s.alt;
      // A single screenshot needs no navigation.
      prev.hidden = next.hidden = shots.length < 2;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.shot));
        dialog.showModal();
      });
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    close.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    });

    // Clicking anywhere that is not the image, its caption or a control
    // closes. The figure fills the dialog, so testing against the figure
    // would mean the surrounding dead space never closed it.
    dialog.addEventListener('click', (e) => {
      const hit = (e.target as HTMLElement).closest(
        '.lightbox__img, .lightbox__caption, .lightbox__btn',
      );
      if (!hit) dialog.close();
    });
  });
</script>
