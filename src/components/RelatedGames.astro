---
import GameCard from './GameCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { games: CollectionEntry<'games'>[]; heading?: string }
const { games, heading = 'Related ROMs' } = Astro.props;
---
{games.length > 0 && (
  <section aria-labelledby="related">
    <h2 id="related" class="font-display text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">{heading}</h2>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {games.map((g) => <GameCard game={g} />)}
    </div>
  </section>
)}
