---
interface Props {
  rows: { version?: string; date?: Date; notes?: string; fileSize?: string }[];
  gameTitle: string;
}
const { rows, gameTitle } = Astro.props;
const sorted = [...rows].sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
---
{rows.length > 0 && (
<section aria-labelledby="versions" class="surface overflow-hidden">
  <div class="border-b border-[var(--border)] px-5 py-3">
    <h2 id="versions" class="font-display text-base font-bold tracking-wide text-white uppercase">Version history</h2>
    <p class="mt-1 text-sm text-[var(--text-muted)]">Every released update for {gameTitle}, newest first.</p>
  </div>
  <div class="table-scroll">
    <table class="w-full text-left text-sm">
      <thead class="bg-[var(--bg-raised)] text-xs tracking-wide text-[var(--text-muted)] uppercase">
        <tr>
          <th scope="col" class="px-5 py-2.5 font-semibold">Version</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Released</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Size</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Patch notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        {sorted.map((r) => (
          <tr>
            <th scope="row" class="px-5 py-3 font-mono font-medium whitespace-nowrap">{r.version ?? '—'}</th>
            <td class="px-5 py-3 whitespace-nowrap text-[var(--text-muted)]">
              {r.date ? <time datetime={r.date.toISOString()}>{dateFmt.format(r.date)}</time> : '—'}
            </td>
            <td class="px-5 py-3 whitespace-nowrap tabular-nums">{r.fileSize ?? '—'}</td>
            <td class="px-5 py-3">{r.notes ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
)}
