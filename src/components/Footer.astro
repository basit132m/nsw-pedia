---
import { FOOTER_LINKS, NAV, SITE } from '@lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-[var(--border)] bg-[var(--bg-surface)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-2">
      <img src="/logo.webp" alt={SITE.name} width="200" height="39" class="h-9 w-auto" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-[var(--text-muted)]">{SITE.description}</p>
    </div>
    <div>
      <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Browse</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.map((i) => (
          <li><a href={i.href} class="text-[var(--text-muted)] hover:text-white">{i.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Site</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {FOOTER_LINKS.map((i) => (
          <li><a href={i.href} class="text-[var(--text-muted)] hover:text-white">{i.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--border)]">
    <div class="mx-auto max-w-6xl px-4 py-6 text-xs leading-relaxed text-[var(--text-muted)]">
      <p>&copy; {year} {SITE.name}. Not affiliated with, endorsed by or sponsored by Nintendo Co., Ltd.
      Nintendo Switch is a trademark of Nintendo. Game titles, box art and trademarks belong to their respective owners.</p>
      <p class="mt-2">NSWPEDIA does not host or link to copyrighted game files. Downloads are limited to
      homebrew and public-domain software released under licences that permit redistribution.</p>
    </div>
  </div>
</footer>
