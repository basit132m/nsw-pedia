---
interface Row {
  emulatorName?: string;
  emulatorSlug?: string;
  platform?: string;
  device?: string;
  fps?: string;
  status?: string;
  notes?: string;
  source?: 'tested' | 'reported';
  sourceUrl?: string;
  testedOn?: Date;
  testedByName?: string;
}
interface Props { rows: Row[]; gameTitle: string }
const { rows, gameTitle } = Astro.props;

/** Status to chip tone. Tones are themed in global.css, so they stay
    legible in light mode as well as dark. */
const STATUS_TONE: Record<string, string> = {
  Perfect: 'good',
  Playable: 'ok',
  Ingame: 'warn',
  Menus: 'caution',
  Boots: 'bad',
  Nothing: 'neutral',
};
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
const dates = rows.map((r) => r.testedOn).filter((d): d is Date => d instanceof Date);
const lastTested = dates.length ? new Date(Math.max(...dates.map((d) => d.getTime()))) : undefined;
---
{rows.length > 0 && (
<section aria-labelledby="compat" class="surface overflow-hidden">
  <div class="border-b border-[var(--border)] px-5 py-3">
    <h2 id="compat" class="font-display text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">
      Emulator compatibility
    </h2>
    <p class="mt-1 text-sm text-[var(--text-muted)]">
      Compatibility for {gameTitle}{lastTested && <>, newest result {dateFmt.format(lastTested)}</>}.
      Rows marked <strong class="text-[var(--text)]">Tested</strong> were run by us;
      <strong class="text-[var(--text)]">Reported</strong> rows link to the community source they came
      from. See <a href="/methodology/" class="link-accent">how we test</a>.
    </p>
  </div>
  <div class="table-scroll">
    <table class="w-full text-left text-sm">
      <thead class="bg-[var(--bg-raised)] text-xs tracking-wide text-[var(--text-muted)] uppercase">
        <tr>
          <th scope="col" class="px-5 py-2.5 font-semibold">Emulator</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Platform</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Device tested</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">FPS</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Status</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Notes</th>
          <th scope="col" class="px-5 py-2.5 font-semibold">Result from</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)]">
        {rows.map((r) => (
          <tr>
            <th scope="row" class="px-5 py-3 font-medium">
              {r.emulatorSlug ? (
                <a href={`/emulators/${r.emulatorSlug}/`} class="link-accent">{r.emulatorName}</a>
              ) : (
                r.emulatorName ?? '—'
              )}
            </th>
            <td class="px-5 py-3 text-[var(--text-muted)]">{r.platform ?? '—'}</td>
            <td class="px-5 py-3">{r.device ?? '—'}</td>
            <td class="px-5 py-3 font-mono tabular-nums">{r.fps ?? '—'}</td>
            <td class="px-5 py-3">
              {r.status ? (
                <span class="chip" data-tone={STATUS_TONE[r.status] ?? 'neutral'}>{r.status}</span>
              ) : '—'}
            </td>
            <td class="px-5 py-3 text-[var(--text-muted)]">{r.notes ?? '—'}</td>
            <td class="px-5 py-3 whitespace-nowrap text-[var(--text-muted)]">
              {r.testedOn && <time datetime={r.testedOn.toISOString()}>{dateFmt.format(r.testedOn)}</time>}
              {r.source === 'tested' ? (
                <span class="block text-xs">
                  <span class="tone-good font-semibold">Tested</span>
                  {r.testedByName && <> by {r.testedByName}</>}
                </span>
              ) : r.source === 'reported' ? (
                <span class="block text-xs">
                  <span class="tone-info font-semibold">Reported</span>
                  {r.sourceUrl && <> · <a href={r.sourceUrl} rel="nofollow noopener" class="link-accent">source</a></>}
                </span>
              ) : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
)}
