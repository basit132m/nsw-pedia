---
import type { CollectionEntry } from 'astro:content';

interface Props {
  game: CollectionEntry<'games'>['data'];
  publisherSlug?: string;
  publisherName?: string;
}
const { game, publisherSlug, publisherName } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });

const ratings = [
  game.ageRatings.esrb && `ESRB ${game.ageRatings.esrb}`,
  game.ageRatings.pegi && `PEGI ${game.ageRatings.pegi}`,
  game.ageRatings.cero && `CERO ${game.ageRatings.cero}`,
].filter(Boolean).join(' · ');

const playerSummary = [
  game.players.offline && `${game.players.offline} offline`,
  game.players.localCoop ? `${game.players.localCoop} local co-op` : undefined,
  game.players.online ? `${game.players.online} online` : undefined,
  game.players.nsoRequired ? 'Nintendo Switch Online required' : undefined,
].filter(Boolean).join(' · ');

const contentSummary = game.contentType
  ? game.includedUpdate
    ? `${game.contentType} · includes update ${game.includedUpdate}`
    : game.contentType
  : undefined;

type Row = { label: string; value?: string; kind?: 'publisher' | 'code' | 'hash' };

/** Only rows with a value are rendered, so a partly-filled page stays clean. */
const rows: Row[] = [
  { label: 'Game name', value: game.title },
  { label: 'Also known as', value: game.alternateTitles.join(' · ') || undefined },
  { label: 'Genre', value: game.genres.join(', ') || undefined },
  { label: 'Developer', value: game.developer },
  { label: 'Published by', value: publisherName, kind: 'publisher' },
  { label: 'Release date', value: game.releaseDate ? dateFmt.format(game.releaseDate) : undefined },
  { label: 'Series', value: game.series },
  { label: 'Version', value: game.version },
  { label: 'Title ID', value: game.titleId, kind: 'code' },
  { label: 'Build ID', value: game.buildId, kind: 'code' },
  { label: 'Size', value: game.fileSize },
  { label: 'File type', value: game.fileType && (game.trimmed ? `${game.fileType} (trimmed)` : game.fileType) },
  { label: 'Required firmware', value: game.requiredFirmware && `${game.requiredFirmware} or later` },
  { label: 'Region', value: game.region },
  { label: 'Content type', value: contentSummary },
  { label: 'DLC available', value: game.dlcCount ? `${game.dlcCount} item${game.dlcCount === 1 ? '' : 's'}` : undefined },
  { label: 'Language (audio)', value: game.languages.audio.join(', ') || undefined },
  { label: 'Language (subtitles)', value: game.languages.subtitles.join(', ') || undefined },
  { label: 'Players', value: playerSummary || undefined },
  { label: 'Play modes', value: game.playModes.join(' · ') || undefined },
  { label: 'Features', value: game.features.join(', ') || undefined },
  { label: 'Age rating', value: ratings || undefined },
  { label: 'SHA-256', value: game.checksums.sha256, kind: 'hash' },
  { label: 'CRC32', value: game.checksums.crc32, kind: 'hash' },
].filter((r): r is Row & { value: string } => Boolean(r.value));
---
{rows.length > 0 && (
  <section aria-labelledby="game-details" class="surface overflow-hidden">
    <h2 id="game-details" class="font-display border-b border-[var(--border)] px-5 py-3 text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">
      Game details
    </h2>
    <dl class="divide-y divide-[var(--border)] text-sm">
      {rows.map((row) => (
        <div class="grid grid-cols-1 gap-1 px-5 py-3 sm:grid-cols-[minmax(0,11rem)_1fr] sm:gap-4">
          <dt class="font-medium text-[var(--text-muted)]">{row.label}</dt>
          <dd class="text-[var(--text)]">
            {row.kind === 'publisher' && publisherSlug ? (
              <a href={`/publishers/${publisherSlug}/`} class="link-accent">{row.value}</a>
            ) : row.kind === 'code' ? (
              <code class="font-mono text-[var(--accent)]">{row.value}</code>
            ) : row.kind === 'hash' ? (
              <code class="font-mono text-xs break-all text-[var(--text-muted)]">{row.value}</code>
            ) : (
              row.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}
