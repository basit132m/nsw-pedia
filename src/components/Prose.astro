---
// Typographic defaults for authored Markdown bodies.
---
<div class="prose-nsw max-w-none">
  <slot />
</div>

<style is:global>
  .prose-nsw { color: var(--text); line-height: 1.75; }
  .prose-nsw > * + * { margin-top: 1.1em; }
  .prose-nsw h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-top: 2.2em;
    scroll-margin-top: 5rem;
  }
  .prose-nsw h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    margin-top: 1.8em;
    scroll-margin-top: 5rem;
  }
  .prose-nsw a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose-nsw ul, .prose-nsw ol { padding-left: 1.4em; }
  .prose-nsw ul { list-style: disc; }
  .prose-nsw ol { list-style: decimal; }
  .prose-nsw li + li { margin-top: 0.4em; }
  .prose-nsw code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-raised);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose-nsw pre {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
  }
  .prose-nsw pre code { background: none; padding: 0; }
  .prose-nsw blockquote {
    border-left: 3px solid var(--color-red-brand);
    padding-left: 1rem;
    color: var(--text-muted);
  }
  .prose-nsw table { width: 100%; font-size: 0.9em; border-collapse: collapse; }
  .prose-nsw th, .prose-nsw td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
  .prose-nsw th { background: var(--bg-raised); }
  .prose-nsw img { border-radius: 0.5rem; }
</style>
