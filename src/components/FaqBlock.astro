---
interface Props { items: { question?: string; answer?: string }[]; heading?: string }
const { items: raw, heading = 'Frequently asked questions' } = Astro.props;

// A question with no answer (or vice versa) is skipped rather than rendered half-empty.
const items = raw.filter(
  (f): f is { question: string; answer: string } => Boolean(f.question && f.answer),
);
---
{items.length > 0 && (
  <section aria-labelledby="faq" class="surface overflow-hidden">
    <h2 id="faq" class="font-display border-b border-[var(--border)] px-5 py-3 text-base font-bold tracking-wide text-[var(--text-strong)] uppercase">
      {heading}
    </h2>
    <div class="divide-y divide-[var(--border)]">
      {items.map((f) => (
        <details class="group px-5 py-3">
          <summary class="cursor-pointer list-none font-medium text-[var(--text)] marker:content-none">
            <span class="flex items-start justify-between gap-4">
              {f.question}
              <span aria-hidden="true" class="mt-1 shrink-0 text-[var(--text-muted)] transition-transform group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
