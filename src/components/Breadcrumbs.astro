---
interface Props { crumbs: { name: string; href: string }[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-[var(--text-muted)]">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-[var(--color-chrome-700)]">/</span>}
        {i === crumbs.length - 1 ? (
          <span aria-current="page" class="text-[var(--text)]">{c.name}</span>
        ) : (
          <a href={c.href} class="hover:text-white">{c.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
