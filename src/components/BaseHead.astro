---
import { SITE, abs } from '@lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: string;
  noindex?: boolean;
  keywords?: string;
  /** True when the title was written by hand: used verbatim, no site suffix. */
  exactTitle?: boolean;
}

const {
  title,
  description,
  path,
  image = '/og-default.png',
  type = 'website',
  publishedAt,
  updatedAt,
  jsonLd,
  noindex = false,
  keywords,
  exactTitle = false,
} = Astro.props;

const canonical = abs(path);
const ogImage = abs(image);
// A hand-written title is used exactly as given — no site-name suffix — so the
// author controls the full length of what appears in the search result.
const fullTitle =
  exactTitle || title === SITE.title || title.includes(SITE.name)
    ? title
    : `${title} | ${SITE.name}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<link rel="canonical" href={canonical} />

<!-- Google Search Console site verification. Google re-checks this
     periodically, so it has to stay even after the property is verified. -->
<meta name="google-site-verification" content="KCy7So1FLlQlLfHHuyA3c_DJvg9BnCr2_Th5i3YdNng" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="theme-color" content={SITE.themeColor} />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={abs('/rss.xml')} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_US" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
